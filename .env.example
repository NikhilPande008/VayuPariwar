# Server-side only environment variables.
# NEVER prefix these with NEXT_PUBLIC_ or expose them to the browser.

# Google Gemini API key (required for /api/plan, /api/briefing, /api/chat)
# Obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# WAQI API token for live Indian CPCB ground station readings (optional; falls back to Open-Meteo if omitted/unavailable)
# Obtain from https://aqicn.org/data-platform/token/
WAQI_TOKEN=your_waqi_token_here
